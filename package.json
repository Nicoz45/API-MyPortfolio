{
  "name": "api-myportfolio",
  "version": "1.0.0",
  "description": "MyPortfolio Backend",
  "main": "main.js",
  "scripts": {
    "start": "node ./src/main.js",
    "dev": "node --watch ./src/main.js",
    "nodemon-dev": "nodemon ./src/main.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch"
  },
  "jest": {
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "keywords": [],
  "author": "Nicoz45",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "nodemailer": "^9.0.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "glob": "^13.0.6"
